  text?: string;
  assetId?: string;
  fontSize?: number;
  fontWeight?: number;
  fontFamily?: string;
  color?: string;
  align?: "left" | "center" | "right";
  lineHeight?: number;
  letterSpacing?: number;
  opacity?: number;
  objectFit?: "cover" | "contain";
